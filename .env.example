# Öffentliche URL der App (für OAuth-Redirect), z.B. https://los.meinedomain.de
BASE_URL=http://localhost:3000
PORT=3000

# Twitch-App unter https://dev.twitch.tv/console/apps anlegen
# OAuth Redirect URL dort eintragen: <BASE_URL>/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: nur dieser Twitch-Login darf sich ins Dashboard einloggen
# (leer = der erste Login wird als Kanal-Inhaber gespeichert)
ALLOWED_LOGIN=

# Optional: Dashboard-Passwort für den Testmodus ohne Twitch (leer = kein Testmodus-Login)
ADMIN_PASSWORD=
